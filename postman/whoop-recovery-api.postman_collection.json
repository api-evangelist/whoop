{
  "info": {
    "_postman_id": "5c0e9a67-8a3f-4176-ac5a-3a728b06a974",
    "name": "WHOOP Activity ID Mapping Recovery API",
    "description": "The WHOOP API exposes member fitness, strain, recovery, sleep, workout, and body measurement data captured by the WHOOP wrist-worn wearable. OAuth 2.0 protected; v2 endpoints use UUID identifiers and webhook notifications keep integrations current.\n\nContact Support:\n Name: WHOOP Developer Support",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-07-28T03:29:48.000Z",
    "updatedAt": "2026-07-28T03:29:48.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-5c0e9a67-8a3f-4176-ac5a-3a728b06a974"
  },
